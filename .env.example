# Runtime
AUTOPEER__APP_ENV=dev
AUTOPEER__LOG_LEVEL=INFO
AUTOPEER__DATABASE_PATH=/data/autopeer/jobs.sqlite3

# Mount a dedicated clean checkout of Bird2-Configuration here in Docker.
AUTOPEER__CONFIG_REPO_PATH=/config-repo
AUTOPEER__DEPLOY_ENABLED=false
AUTOPEER__GIT_PUSH_ENABLED=false
AUTOPEER__GIT_SYNC_ENABLED=false
AUTOPEER__ALLOW_DIRTY_REPO=false
AUTOPEER__GIT_AUTHOR_NAME="Autopeer Bot"
AUTOPEER__GIT_AUTHOR_EMAIL=autopeer@localhost

# Production OIDC login. Register this exact callback URL with the provider.
# AUTOPEER__AUTH_MODE=oidc
# AUTOPEER__SESSION_SECRET=replace-with-a-long-random-value
# AUTOPEER__OIDC_ISSUER=https://dn42.g-load.eu
# AUTOPEER__OIDC_CLIENT_ID=replace-with-registered-client-id
# AUTOPEER__OIDC_CLIENT_SECRET=replace-with-client-secret
# AUTOPEER__OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc-client-secret
# AUTOPEER__OIDC_REDIRECT_URI=https://autopeer.example.dn42/api/v1/auth/callback

AUTOPEER__ADMIN_ASNS=4242422024,4242420000

# Metrics are collected in memory by a background task. The optional target file
# remains supported for exporter targets not stored in node metadata.
# AUTOPEER__METRICS_TARGETS_FILE=/config/metrics-targets.yml
AUTOPEER__METRICS_REFRESH_SECONDS=30
AUTOPEER__METRICS_MAX_CONCURRENCY=4
# Configuration files are scanned into an in-memory snapshot for API reads.
AUTOPEER__CONFIG_REFRESH_SECONDS=30

# Optional root deployment agent integration.
# AUTOPEER__AGENT_ENABLED=true
# AUTOPEER__AGENT_CA_FILE=/run/secrets/autopeer-agent-ca.pem
# AUTOPEER__AGENT_CLIENT_CERT_FILE=/run/secrets/autopeer-agent-client.pem
# AUTOPEER__AGENT_CLIENT_KEY_FILE=/run/secrets/autopeer-agent-client.key
# AUTOPEER__AGENT_SIGNING_PRIVATE_KEY_FILE=/run/secrets/autopeer-agent-signing.key
# AUTOPEER__AGENT_TIMEOUT_SECONDS=15
