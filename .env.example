# Runtime
AUTOPEER__APP_ENV=dev
AUTOPEER__LOG_LEVEL=INFO
AUTOPEER__DATABASE_PATH=/data/autopeer/jobs.sqlite3

# Mount a dedicated clean checkout of Bird2-Configuration here in Docker.
AUTOPEER__CONFIG_REPO_PATH=/config-repo
AUTOPEER__DEPLOY_ENABLED=false
AUTOPEER__GIT_PUSH_ENABLED=false
AUTOPEER__GIT_SYNC_ENABLED=false
AUTOPEER__ALLOW_DIRTY_REPO=false
AUTOPEER__GIT_AUTHOR_NAME="Autopeer Bot"
AUTOPEER__GIT_AUTHOR_EMAIL=autopeer@localhost

# Development auth mode: send X-Autopeer-ASN. For production, set auth mode to kioubit.
AUTOPEER__AUTH_MODE=dev-header
# Comma-separated operator ASN allowlist; one ASN is also valid.
AUTOPEER__ADMIN_ASNS=4242422024,4242423128
# AUTOPEER__SESSION_SECRET=replace-with-a-long-random-value
# AUTOPEER__KIOUBIT_DOMAIN=autopeer.example.dn42
# AUTOPEER__KIOUBIT_PUBLIC_KEY_FILE=/config/kioubit-public-key.pem

# Optional exporter target map, see README.
AUTOPEER__METRICS_TARGETS_FILE=/config/metrics-targets.yml
